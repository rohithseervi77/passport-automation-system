generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// USER & ROLES
// =====================================================

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  email     String   @unique
  
  // ROLES: APPLICANT, OFFICER, POLICE, ADMIN
  role      String   @default("APPLICANT")
  
  // Security & State
  isActive          Boolean  @default(true)
  failedLoginAttempts Int      @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  applicant         Applicant?
  passportOfficer   PassportOfficer?
  police            Police?
  admin             Admin?

  notifications     Notification[]
  auditLogs         AuditLog[]
  resetTokens       PasswordResetToken[]
}

model Admin {
  id          Int    @id @default(autoincrement())
  adminCode   String @unique
  userId      Int    @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =====================================================
// APPLICANT
// =====================================================

model Applicant {
  id          Int    @id @default(autoincrement())
  applicantId String @unique
  name        String
  dob         DateTime
  address     String

  userId      Int  @unique
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  applications Application[]
}

// =====================================================
// PASSPORT OFFICER
// =====================================================

model PassportOfficer {
  id             Int    @id @default(autoincrement())
  officerId      String @unique
  branchLocation String

  userId         Int  @unique
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedApplications Application[]
  passports           Passport[]
}

// =====================================================
// POLICE
// =====================================================

model Police {
  id          Int    @id @default(autoincrement())
  stationCode String
  badgeNumber String @unique

  userId      Int  @unique
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  reports     PoliceReport[]
}

// =====================================================
// APPLICATION & FSM HISTORY
// =====================================================

model Application {
  id             Int      @id @default(autoincrement())
  applicationId  String   @unique
  passportType   String
  status         String   @default("DRAFT")
  submissionDate DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  applicantId    Int
  applicant      Applicant @relation(fields: [applicantId], references: [id])

  officerId      Int?
  officer        PassportOfficer? @relation(fields: [officerId], references: [id])

  documents      Document[]
  appointment    Appointment?
  policeReports  PoliceReport[]
  passport       Passport?
  
  statusHistory  ApplicationStatusHistory[]
  payments       Payment[]
}

model ApplicationStatusHistory {
  id            Int      @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  fromStatus    String
  toStatus      String
  remarks       String?
  changedById   Int?
  changedAt     DateTime @default(now())
}

// =====================================================
// DOCUMENT
// =====================================================

model Document {
  id           Int    @id @default(autoincrement())
  docId        String @unique
  documentType String
  fileStatus   String
  fileUrl      String?
  uploadedAt   DateTime @default(now())

  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

// =====================================================
// APPOINTMENT
// =====================================================

model Appointment {
  id            Int      @id @default(autoincrement())
  appointmentId String   @unique
  date          DateTime
  timeSlot      String
  status        String   @default("AVAILABLE") // BOOKED, COMPLETED, CANCELLED, MISSED

  applicationId Int      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([date, timeSlot])
}

// =====================================================
// PAYMENT
// =====================================================

model Payment {
  id            Int      @id @default(autoincrement())
  transactionId String   @unique
  amount        Float
  status        String   @default("PENDING") // PROCESSING, SUCCESS, FAILED, REFUNDED
  paymentMethod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

// =====================================================
// POLICE REPORT
// =====================================================

model PoliceReport {
  id              Int    @id @default(autoincrement())
  reportId        String @unique
  clearanceStatus String // PENDING, APPROVED, REJECTED, CLARIFICATION_REQUIRED
  remarks         String?
  createdAt       DateTime @default(now())

  applicationId   Int
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  policeId        Int
  police          Police @relation(fields: [policeId], references: [id])
}

// =====================================================
// PASSPORT
// =====================================================

model Passport {
  id             Int      @id @default(autoincrement())
  passportNumber String   @unique
  issueDate      DateTime
  expiryDate     DateTime
  dispatchStatus String   @default("PRINTING") // READY, DISPATCHED, DELIVERED

  applicationId  Int      @unique
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  officerId      Int?
  officer        PassportOfficer? @relation(fields: [officerId], references: [id])
}

// =====================================================
// NOTIFICATIONS & AUDIT LOGS
// =====================================================

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  isRead      Boolean  @default(false)
  type        String   @default("INFO")
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // LOGIN, APPLICATION_SUBMITTED, etc.
  entityId    String?  // E.g., application ID or document ID
  details     String?  // JSON stringified payload
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

model PasswordResetToken {
  id          Int      @id @default(autoincrement())
  token       String   @unique
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  createdAt   DateTime @default(now())
}
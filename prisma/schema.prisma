generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// USER & ROLES
// =====================================================

model User {
  id                  Int       @id @default(autoincrement())
  authUserId          String?   @unique // Supabase Auth User UUID
  username            String    @unique
  email               String    @unique
  
  // ROLES: APPLICANT, OFFICER, POLICE, ADMIN
  role                String    @default("APPLICANT")
  
  // Security & State (No passwords stored in application DB; managed by Supabase Auth)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  applicant           Applicant?
  passportOfficer     PassportOfficer?
  police              Police?
  admin               Admin?

  notifications       Notification[]
  auditLogs           AuditLog[]
  resetTokens         PasswordResetToken[]
  loginHistories      LoginHistory[]

  @@index([authUserId])
  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model Admin {
  id          Int    @id @default(autoincrement())
  adminCode   String @unique
  userId      Int    @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =====================================================
// APPLICANT
// =====================================================

model Applicant {
  id          Int      @id @default(autoincrement())
  applicantId String   @unique
  name        String
  dob         DateTime
  address     String

  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  applications Application[]

  @@index([userId])
}

// =====================================================
// PASSPORT OFFICER
// =====================================================

model PassportOfficer {
  id             Int      @id @default(autoincrement())
  officerId      String   @unique
  branchLocation String

  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedApplications Application[]
  passports           Passport[]

  @@index([userId])
}

// =====================================================
// POLICE
// =====================================================

model Police {
  id          Int      @id @default(autoincrement())
  stationCode String
  badgeNumber String   @unique

  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  reports     PoliceReport[]

  @@index([userId])
}

// =====================================================
// APPLICATION & FSM HISTORY
// =====================================================

model Application {
  id             Int      @id @default(autoincrement())
  applicationId  String   @unique // Application Reference Number (ARN)
  passportType   String   @default("REGULAR (36 Pages)")
  serviceType    String   @default("FRESH") // FRESH, REISSUE
  applicationCategory String @default("NORMAL") // NORMAL, TATKAAL
  bookletType    String   @default("36_PAGES") // 36_PAGES, 60_PAGES
  rpoLocation    String?  @default("RPO Chennai")
  status         String   @default("DRAFT")
  submissionDate DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  // Step 2: Applicant Personal Details
  givenName                  String?
  surname                    String?
  gender                     String?
  dob                        DateTime?
  placeOfBirth               String?
  maritalStatus              String?
  citizenship                String?   @default("By Birth")
  pan                        String?
  voterId                    String?
  employmentType             String?
  educationalQualification   String?
  visibleIdentificationMark  String?
  aadhaarNumber              String?

  // Step 3: Family Details
  fatherName                 String?
  motherName                 String?
  spouseName                 String?
  legalGuardianName          String?

  // Step 4: Address Details
  presentAddressLine1        String?
  presentAddressLine2        String?
  presentCity                String?
  presentDistrict            String?
  presentState               String?
  presentPinCode             String?
  policeStation              String?
  isPermanentSame            Boolean   @default(true)
  permanentAddress           String?

  // Step 5: Emergency Contact
  emergencyName              String?
  emergencyRelationship      String?
  emergencyMobile            String?
  emergencyEmail             String?
  emergencyAddress           String?

  // Step 6: Previous Passport
  hasPreviousPassport        Boolean   @default(false)
  prevPassportNumber         String?
  prevIssueDate              DateTime?
  prevExpiryDate             DateTime?
  prevPlaceOfIssue           String?

  // Step 7: Other Details & Declarations
  hasCriminalRecord          Boolean   @default(false)
  criminalRecordDetails      String?
  hasPendingProceedings      Boolean   @default(false)
  pendingProceedingsDetails  String?
  hasLostPassport            Boolean   @default(false)
  lostPassportDetails        String?
  confirmedDeclaration       Boolean   @default(false)

  // Review & Clarification workflow
  clarificationReason        String?
  clarificationRequestedAt   DateTime?
  clarificationResponse      String?
  clarificationRespondedAt   DateTime?
  officerChecklist           String?   // JSON checklist of verified points
  rejectionReason            String?

  applicantId    Int
  applicant      Applicant @relation(fields: [applicantId], references: [id])

  officerId      Int?
  officer        PassportOfficer? @relation(fields: [officerId], references: [id])

  documents      Document[]
  appointment    Appointment?
  policeReports  PoliceReport[]
  passport       Passport?
  
  statusHistory  ApplicationStatusHistory[]
  payments       Payment[]

  @@index([applicantId])
  @@index([officerId])
  @@index([status])
  @@index([serviceType])
  @@index([applicationCategory])
  @@index([submissionDate])
  @@index([status, applicationCategory])
}

model ApplicationStatusHistory {
  id            Int      @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  fromStatus    String
  toStatus      String
  remarks       String?
  performedBy   String?
  role          String?  @default("SYSTEM")
  changedById   Int?
  changedAt     DateTime @default(now())

  @@index([applicationId])
  @@index([changedAt])
}

// =====================================================
// DOCUMENT
// =====================================================

model Document {
  id                 Int       @id @default(autoincrement())
  docId              String    @unique
  documentType       String
  fileStatus         String    @default("UPLOADED")
  fileUrl            String?
  fileName           String?
  fileSize           Int?
  storagePath        String?
  mimeType           String?
  verificationStatus String    @default("PENDING")
  verifiedBy         String?
  verifiedAt         DateTime?
  uploadedAt         DateTime  @default(now())

  applicationId      Int
  application        Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([documentType])
  @@index([verificationStatus])
}

// =====================================================
// APPOINTMENT
// =====================================================

model Appointment {
  id            Int      @id @default(autoincrement())
  appointmentId String   @unique
  quota         String   @default("NORMAL") // NORMAL, TATKAAL
  location      String   @default("Chennai PSK")
  date          DateTime
  timeSlot      String
  status        String   @default("BOOKED") // BOOKED, COMPLETED, CANCELLED, RESCHEDULED
  rescheduleCount Int    @default(0)

  applicationId Int      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([date, timeSlot])
  @@index([status])
}

// =====================================================
// PAYMENT
// =====================================================

model Payment {
  id            Int      @id @default(autoincrement())
  transactionId String   @unique
  amount        Float
  baseFee       Float    @default(1500)
  additionalFee Float    @default(0)
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED
  paymentMethod String?  // UPI, DEBIT_CARD, CREDIT_CARD, NET_BANKING
  paymentReference String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([status])
  @@index([transactionId])
}

// =====================================================
// POLICE REPORT
// =====================================================

model PoliceReport {
  id              Int      @id @default(autoincrement())
  reportId        String   @unique
  clearanceStatus String   // PENDING, IN_PROGRESS, CLEARED, ADVERSE, CLARIFICATION_REQUIRED
  remarks         String?
  adverseReason   String?
  stationCode     String?
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())

  applicationId   Int
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  policeId        Int?
  police          Police?  @relation(fields: [policeId], references: [id])

  @@index([applicationId])
  @@index([policeId])
  @@index([clearanceStatus])
}

// =====================================================
// PASSPORT
// =====================================================

model Passport {
  id             Int      @id @default(autoincrement())
  passportNumber String   @unique
  issueDate      DateTime
  expiryDate     DateTime
  dispatchStatus String   @default("PRINTING") // PRINTING, READY, DISPATCHED, DELIVERED
  trackingNumber String?

  applicationId  Int      @unique
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  officerId      Int?
  officer        PassportOfficer? @relation(fields: [officerId], references: [id])

  @@index([applicationId])
  @@index([officerId])
  @@index([dispatchStatus])
}

// =====================================================
// NOTIFICATIONS & AUDIT LOGS
// =====================================================

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  isRead      Boolean  @default(false)
  type        String   @default("INFO") // INFO, SUCCESS, WARNING, ALERT
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // LOGIN, APPLICATION_SUBMITTED, etc.
  entityId    String?  // E.g., application ID or document ID
  details     String?  // JSON stringified payload
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model PasswordResetToken {
  id          Int      @id @default(autoincrement())
  token       String   @unique
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// =====================================================
// LOGIN HISTORY (Zero passwords stored)
// =====================================================

model LoginHistory {
  id          Int       @id @default(autoincrement())
  authUserId  String?
  email       String
  role        String?   @default("APPLICANT")
  loginTime   DateTime  @default(now())
  logoutTime  DateTime?
  success     Boolean   @default(true)
  ipAddress   String?
  userAgent   String?
  sessionId   String?
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [authUserId], references: [authUserId], onDelete: SetNull)

  @@index([authUserId])
  @@index([email])
  @@index([loginTime])
  @@index([success])
}

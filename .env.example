# ====================================================================
# Passport Automation System (PAS) — Environment Configuration Template
# ====================================================================

# 1. Supabase PostgreSQL Connection Strings
# Transaction Connection Pooler (Port 6543) used by the Next.js application at runtime
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (Port 5432) used for Prisma CLI schema migrations and seed scripts
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. Authentication Secrets (HMAC SHA-256 for Jose JWT sessions)
AUTH_SECRET="generate-a-secure-random-32-char-string-here"

# 3. Supabase Storage & Client API Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# CRITICAL: Service role key MUST NEVER be shared or exposed to the client browser
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 4. Public Base Application URL
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
